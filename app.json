{
  "expo": {
    "name": "bersaglio",
    "slug": "bersaglio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "myday",
    "splash": {
      "image": "./src/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.lnrufino.bersaglio"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "11b39287-f0f4-4ad1-a47b-7ff99a22dfa6"
      }
    }
  }
}
